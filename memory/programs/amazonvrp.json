  "rules": {
    "mass_scanning_allowed": false,
    "bucket_listing_allowed": true,
    "bucket_download_allowed": false,
    "automated_tools_allowed": true,
    "cve_age_min_days": 30,
    "requires_ownership_proof": true,
    "safe_harbor": true,
